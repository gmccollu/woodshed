#!/bin/bash
# wl-send: send one numbered `woodshed send` run from several sender namespaces at once.
# The count and the rate are split evenly over the chosen namespaces, each with its own
# contiguous block of sequence numbers, so `verifyseq -n COUNT` checks the whole run.
#
#   wl-send --host IP --count N --run ID [--rate R] [--proto udp|tcp|tls|trap] [--framing lf|octet]
#           [--port 514] [--first-seq S] [--size B] [--ns 0-7] [--out DIR] [--timeout SECS]
#           [--detach UNIT]
#           TLS:  [--ca FILE] [--server-name NAME]           (port 6514 unless --port)
#           trap: [--snmp-version 1|2c|3] [--inform] [--inform-timeout DUR] [--community-file FILE]
#                 [--user NAME] [--auth PROTO] [--priv PROTO] [--key-ext draft|alt] [--auth-pass-file FILE]
#                 [--priv-pass-file FILE] [--trap-oid OID|NAME] [--varbinds N] [--engine-id HEX]   (port 162 unless --port)
#           flows (--proto flow-v5|flow-v9|ipfix; port 2055, or 4739 for ipfix, unless --port; --run is 8 hex digits):
#                 [--records-per-packet N] [--domains N] [--sampling N] [--sampled-domains N] [--template-every N]
#                 [--template-first-delay DUR] [--enterprise-ies N] [--events] [--deny-ratio X] [--biflow]
#                 [--flow-log]   each sender writes every record it sent to OUT/flowlog-K.jsonl (`woodshed send --log`):
#                                the ground truth for exactly-once, sums and top-N checks (keep it off for load steps)
#   wl-send --unit-status UNIT | --unit-stop UNIT
#
# Files (--ca and the secret files) must be regular files under $LAB/stage/: the secrets are read by
# `woodshed send` itself from the file, never from a command line. --out must be under /var/tmp/woodpile-lab/
# or $LAB/runs/ (the default with --flow-log is $LAB/runs/RUN/<time>-<pid>, where the driver can fetch it).
# --rate is the total msg/s (0: as fast as possible). --timeout bounds each sender (for the
# firewall-closed checks, where a TCP connect would otherwise wait minutes). --detach runs
# the same send as a transient systemd unit (survives the ssh session); its results go to
# --out. The last line is machine-readable:
#   WLSEND run=ID want=N sent=X senders=K elapsed_s=T rate=R failed=F [udp_out=U sndbuf_errors=E tx_dropped=D] out=DIR
# (informs add: answered=A timed_out=T rtt_p50_max=D rtt_p99_max=D rtt_max=D, the worst sender's figures)
# udp_out and sndbuf_errors are the namespaces' own UDP counters (/proc/net/snmp OutDatagrams, SndbufErrors) over the
# send, summed; tx_dropped is the parent NIC's: the sender end of a loss check (UDP has no backpressure).
# Exit status 0 when every sender sent its whole share. Run as root (ip netns exec).
set -euo pipefail
LAB=${WL_HOME:-/opt/woodpile-lab}
WP=$LAB/bin/woodshed
CONF=${WL_CONF:-$LAB/senders.conf}
DRY=${WL_DRYRUN:-}

host="" port="" proto=udp framing=lf count=0 rate=0 run="" first=0 size=160 nsspec="" out="" tmo="" detach=""
ca="" sname="" topts=() fopts=() flowlog=""
orig=("$@")
labfile() { # labfile FLAG PATH: a regular file under $LAB/stage/ (no .. and no symlink games)
	local f=$2 r st
	st=$(readlink -f "$LAB/stage" 2>/dev/null || echo /nonexistent)
	r=$(readlink -f -- "$f" 2>/dev/null || echo "")
	[[ "$f" =~ ^[A-Za-z0-9._/-]+$ ]] && [[ "$f" != *..* ]] && [ ! -L "$f" ] && [ -n "$r" ] && [[ "$r" == "$st/"* ]] && [ -f "$r" ] ||
		{ echo "wl-send: $1 must be a regular file under $LAB/stage/: $f" >&2; exit 2; }
}
while [ $# -gt 0 ]; do
	case "$1" in
	--host) host=$2; shift 2 ;;
	--port) port=$2; shift 2 ;;
	--proto) proto=$2; shift 2 ;;
	--framing) framing=$2; shift 2 ;;
	--count) count=$2; shift 2 ;;
	--rate) rate=$2; shift 2 ;;
	--run) run=$2; shift 2 ;;
	--first-seq) first=$2; shift 2 ;;
	--size) size=$2; shift 2 ;;
	--ns) nsspec=$2; shift 2 ;;
	--out) out=$2; shift 2 ;;
	--timeout) tmo=$2; shift 2 ;;
	--detach) detach=$2; shift 2 ;;
	--ca) ca=$2; shift 2 ;;
	--server-name) sname=$2; shift 2 ;;
	--inform) topts+=(--inform); shift ;;
	--inform-timeout) topts+=(--timeout "$2"); shift 2 ;;
	--community-file | --auth-pass-file | --priv-pass-file) labfile "$1" "$2"; topts+=("$1" "$2"); shift 2 ;;
	--snmp-version | --user | --auth | --priv | --key-ext | --trap-oid | --varbinds | --engine-id)
		[[ "$2" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "wl-send: bad value for $1" >&2; exit 2; }
		topts+=("$1" "$2"); shift 2 ;;
	--records-per-packet | --domains | --sampling | --sampled-domains | --template-every | --enterprise-ies)
		[[ "$2" =~ ^[0-9]{1,6}$ ]] || { echo "wl-send: $1 takes a number" >&2; exit 2; }
		fopts+=("$1" "$2"); shift 2 ;;
	--template-first-delay)
		[[ "$2" =~ ^[0-9]{1,5}(ms|s|m)$ ]] || { echo "wl-send: $1 takes a duration such as 5s" >&2; exit 2; }
		fopts+=("$1" "$2"); shift 2 ;;
	--deny-ratio)
		[[ "$2" =~ ^(0(\.[0-9]{1,3})?|1(\.0{1,3})?)$ ]] || { echo "wl-send: --deny-ratio takes 0 to 1" >&2; exit 2; }
		fopts+=("$1" "$2"); shift 2 ;;
	--events | --biflow) fopts+=("$1"); shift ;;
	--flow-log) flowlog=1; shift ;;
	--unit-status)
		systemctl status --no-pager "$2" 2>&1 | head -5 || true
		exit 0 ;;
	--unit-stop)
		systemctl stop "$2"; exit 0 ;;
	*) echo "wl-send: unknown option $1" >&2; exit 2 ;;
	esac
done
[ -n "$host" ] && [ -n "$run" ] && [ "$count" -gt 0 ] || { echo "wl-send: --host, --run and --count are required" >&2; exit 2; }
isflow=""
case "$proto" in udp | tcp | tls | trap) ;; flow-v5 | flow-v9 | ipfix) isflow=1 ;; *) echo "wl-send: --proto udp|tcp|tls|trap|flow-v5|flow-v9|ipfix" >&2; exit 2 ;; esac
if [ -z "$isflow" ] && { [ ${#fopts[@]} -gt 0 ] || [ -n "$flowlog" ]; }; then
	echo "wl-send: the flow options are for --proto flow-v5|flow-v9|ipfix" >&2; exit 2
fi
[ "$proto" = tls ] || [ -z "$ca$sname" ] || { echo "wl-send: --ca and --server-name are for --proto tls" >&2; exit 2; }
[ "$proto" = trap ] || [ ${#topts[@]} = 0 ] || { echo "wl-send: the SNMP options are for --proto trap" >&2; exit 2; }
[ -z "$ca" ] || labfile --ca "$ca"
[ -z "$sname" ] || [[ "$sname" =~ ^[A-Za-z0-9.:-]+$ ]] || { echo "wl-send: bad --server-name" >&2; exit 2; }
if [ -z "$port" ]; then case "$proto" in tls) port=6514 ;; trap) port=162 ;; flow-v5 | flow-v9) port=2055 ;; ipfix) port=4739 ;; *) port=514 ;; esac; fi
[[ "$port" =~ ^[0-9]{1,5}$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || { echo "wl-send: bad --port" >&2; exit 2; }
[[ "$run" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "wl-send: bad --run" >&2; exit 2; }
[ -z "$isflow" ] || [[ "$run" =~ ^[0-9a-f]{8}$ ]] || { echo "wl-send: a flow --run is 8 lowercase hex digits" >&2; exit 2; }
# optional allowlist of target addresses (root-owned, one per line): refuse any other --host
if [ -f "$LAB/targets.allow" ] && ! grep -qxF -- "$host" "$LAB/targets.allow"; then
	echo "wl-send: --host $host is not in $LAB/targets.allow" >&2; exit 2
fi
[ -z "$DRY" ] && [ -z "${WL_TEST_NO_NETNS:-}" ] && [ "$(id -u)" != 0 ] && { echo "wl-send: run as root" >&2; exit 2; }

# shellcheck source=/dev/null
[ -f "$CONF" ] && . "$CONF"
nall=$(($(echo ${IPS:-} | wc -w)))
[ -n "$DRY" ] && [ "$nall" = 0 ] && nall=8
[ "$nall" -gt 0 ] || { echo "wl-send: no IPS in $CONF" >&2; exit 2; }
[ -n "$nsspec" ] || nsspec=0-$((nall - 1))
list=()
IFS=, read -r -a parts <<<"$nsspec"
for p in "${parts[@]}"; do
	if [[ "$p" =~ ^([0-9]+)-([0-9]+)$ ]]; then
		for ((k = BASH_REMATCH[1]; k <= BASH_REMATCH[2]; k++)); do list+=("$k"); done
	elif [[ "$p" =~ ^[0-9]+$ ]]; then list+=("$p")
	else echo "wl-send: bad --ns $nsspec" >&2; exit 2; fi
done
for k in "${list[@]}"; do [ "$k" -lt "$nall" ] || { echo "wl-send: namespace $k doesn't exist ($nall configured)" >&2; exit 2; }; done
n=${#list[@]}
[ "$count" -ge "$n" ] || { echo "wl-send: --count $count is smaller than the $n senders" >&2; exit 2; }

# one directory per invocation: two sends of the same run started in the same second must not share a plan/summary
if [ -z "$out" ]; then
	if [ -n "$flowlog" ]; then out=$LAB/runs/$run/$(date -u +%Y%m%dT%H%M%SZ)-$$
	else out=/var/tmp/woodpile-lab/send-$run-$(date -u +%Y%m%dT%H%M%SZ)-$$; fi
fi
# --out only under the lab's own scratch dirs (this runs as root)
[[ "$out" =~ ^(/var/tmp/woodpile-lab|$LAB/runs)/[A-Za-z0-9._/-]+$ ]] && [[ "$out" != *..* ]] ||
	{ echo "wl-send: --out must be under /var/tmp/woodpile-lab/ or $LAB/runs/: $out" >&2; exit 2; }
mkdir -p "$out"

if [ -n "$detach" ]; then
	[[ "$detach" =~ ^woodpile-lab-[A-Za-z0-9_-]+$ ]] || { echo "wl-send: --detach UNIT must be woodpile-lab-*" >&2; exit 2; }
	args=()
	skip=0
	for a in "${orig[@]}"; do
		if [ "$skip" = 1 ]; then skip=0; continue; fi
		case "$a" in --detach | --out) skip=1; continue ;; esac
		args+=("$a")
	done
	if [ -n "$DRY" ]; then echo "DRY systemd-run --unit=$detach --collect $LAB/bin/wl-send ${args[*]} --out $out"; exit 0; fi
	systemd-run --unit="$detach" --collect --quiet --property=KillMode=control-group "$LAB/bin/wl-send" "${args[@]}" --out "$out"
	echo "WLSEND detached unit=$detach out=$out"
	exit 0
fi

# udpc before|after: each namespace's UDP OutDatagrams and SndbufErrors, and the parent NIC's tx_dropped, into $out/udp-*
udpc() {
	[ -z "$DRY" ] && [ -z "${WL_TEST_NO_NETNS:-}" ] || return 0
	local k
	for k in "${list[@]}"; do
		ip netns exec "wps$k" cat /proc/net/snmp 2>/dev/null | awk '$1 == "Udp:" { if (h) { print $5, $7 } else { h = 1 } }' >"$out/udp-$1-$k" || true
	done
	cat "/sys/class/net/${PARENT:-none}/statistics/tx_dropped" >"$out/udp-$1-parent" 2>/dev/null || true
}
udpc before
base=$((count / n)) extra=$((count % n))
seq=$first
pids=()
for ((j = 0; j < n; j++)); do
	k=${list[$j]}
	c=$base
	[ "$j" -lt "$extra" ] && c=$((c + 1))
	r=0
	[ "$rate" != 0 ] && r=$(python3 -c "print(round($rate / $n, 3))")
	cmd=("$WP" send --host "$host" --port "$port" --proto "$proto" --count "$c" --rate "$r" --run "$run" --first-seq "$seq")
	case "$proto" in
	trap) cmd+=(${topts[@]+"${topts[@]}"}) ;;   # woodshed send refuses --framing, --size and --hostname with traps
	flow-v5 | flow-v9 | ipfix)                   # and with flows (records have no text)
		cmd+=(${fopts[@]+"${fopts[@]}"})
		[ -z "$flowlog" ] || cmd+=(--log "$out/flowlog-$k.jsonl") ;;
	*) cmd+=(--framing "$framing" --size "$size" --hostname "wl-sender-$k") ;;
	esac
	[ -z "$ca" ] || cmd+=(--ca "$ca")
	[ -z "$sname" ] || cmd+=(--server-name "$sname")
	echo "$k $c $seq" >>"$out/plan"
	if [ -n "$DRY" ]; then
		echo "DRY ns=wps$k ${cmd[*]}"
	else
		nsx=(ip netns exec "wps$k")
		[ -n "${WL_TEST_NO_NETNS:-}" ] && nsx=() # tests only: run without a namespace
		if [ -n "$tmo" ]; then
			${nsx[@]+"${nsx[@]}"} timeout "$tmo" "${cmd[@]}" >"$out/sender-$k.out" 2>&1 &
		else
			${nsx[@]+"${nsx[@]}"} "${cmd[@]}" >"$out/sender-$k.out" 2>&1 &
		fi
		pids+=($!)
	fi
	seq=$((seq + c))
done
[ -n "$DRY" ] && exit 0
failed=0
for p in "${pids[@]}"; do wait "$p" || failed=$((failed + 1)); done
udpc after
python3 - "$out" "$run" "$count" "$failed" <<'PY' | tee "$out/summary"
import re, sys, glob, os
out, run, want, failed = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
def secs(d):
    t = 0.0
    for v, u in re.findall(r"([0-9.]+)(h|ms|µs|us|ns|m|s)", d):
        t += float(v) * {"h": 3600, "m": 60, "s": 1, "ms": 1e-3, "µs": 1e-6, "us": 1e-6, "ns": 1e-9}[u]
    return t
plan = {l.split()[0]: int(l.split()[1]) for l in open(os.path.join(out, "plan"))}
sent = 0; el = 0.0; short = 0
inf = None   # informs: answered, timed out, the worst sender's p50/p99/max round trip (seconds)
for k, c in sorted(plan.items(), key=lambda x: int(x[0])):
    try:
        txt = open(os.path.join(out, f"sender-{k}.out"), errors="replace").read()
    except OSError:
        txt = ""
    m = (re.search(r"Sent (\d+) (?:[A-Z0-9-]+ )?(?:messages?|traps?|informs?|records?) .*? in (\S+) \(", txt) or
         re.search(r"Sent (\d+) (?:[A-Z0-9-]+ )?(?:message|trap|inform|record)", txt))
    s = int(m.group(1)) if m else 0
    e = secs(m.group(2)) if m and m.lastindex and m.lastindex >= 2 else 0.0
    sent += s; el = max(el, e)
    a = re.search(r"(\d+) answered, (\d+) timed out", txt)
    if a:
        inf = inf or {"answered": 0, "timed_out": 0, "p50": 0.0, "p99": 0.0, "max": 0.0}
        inf["answered"] += int(a.group(1)); inf["timed_out"] += int(a.group(2))
        rt = re.search(r"round trip p50 (\S+), p99 (\S+), max (\S+?)\.?$", txt, re.M)
        if rt:
            for key, val in zip(("p50", "p99", "max"), rt.groups()):
                inf[key] = max(inf[key], secs(val))
    if s != c:
        short += 1
        print(f"sender {k}: sent {s} of {c}: {txt.strip().splitlines()[-1] if txt.strip() else 'no output'}")
rate = sent / el if el else 0
extra = ""
def nums(name):
    try:
        return [int(x) for x in open(os.path.join(out, name)).read().split()]
    except (OSError, ValueError):
        return None
uo = se = 0; have = False
for k in plan:
    b, a = nums(f"udp-before-{k}"), nums(f"udp-after-{k}")
    if b and a and len(b) == len(a) == 2:
        uo += a[0] - b[0]; se += a[1] - b[1]; have = True
pb, pa = nums("udp-before-parent"), nums("udp-after-parent")
if have:
    extra += f" udp_out={uo} sndbuf_errors={se}" + (f" tx_dropped={pa[0] - pb[0]}" if pb and pa else "")
if inf:
    extra += (f" answered={inf['answered']} timed_out={inf['timed_out']} rtt_p50_max={inf['p50'] * 1000:.2f}ms"
             f" rtt_p99_max={inf['p99'] * 1000:.2f}ms rtt_max={inf['max'] * 1000:.2f}ms")
print(f"WLSEND run={run} want={want} sent={sent} senders={len(plan)} elapsed_s={el:.3f} rate={rate:.0f} failed={max(failed, short)}{extra} out={out}")
PY
[ "$failed" = 0 ] && grep -q " failed=0 " "$out/summary"
